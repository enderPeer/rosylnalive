<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Struct layouts assume 64-bit pointers / size_t. -->
    <PlatformTarget>x64</PlatformTarget>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="VkTypes.fs" />
    <Compile Include="VkCore.Generated.fs" />
    <Compile Include="VkStructs.fs" />
    <Compile Include="VkCommands.fs" />
    <Compile Include="DeviceCheck.fs" />
  </ItemGroup>

</Project>
