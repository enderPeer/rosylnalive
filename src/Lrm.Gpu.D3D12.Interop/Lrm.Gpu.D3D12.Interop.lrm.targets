<Project>
  <!--
    Owner: R3. No F# tail calls: a call that receives the address of a stack local (NativePtr.toNativeInt &&x) must
    not be compiled with the tail. prefix, which frees the caller's frame before the callee reads it (ADR R3-0001,
    D3D12ComIdiom contract).
  -->
  <PropertyGroup>
    <Tailcalls>false</Tailcalls>
  </PropertyGroup>
</Project>
