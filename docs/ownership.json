{
  "schema": "lrm.ownership/1",
  "about": "OwnershipAndContractChange contract: each workstream family owns the paths matched by its globs; slices (a/b ids) share their family's paths. A leading '!' excludes paths from that family. '**' matches any number of path segments, '*' matches within one segment. Every tracked file belongs to exactly one family. Branches are ws/<id>-<slug>, ws/<id>-fix-<slug> and int/<slug>; the hygiene job (S0b) fails edits outside the branch's family. The integrator (int/*) may touch any path. There are no mid-plan handovers.",
  "branches": [
    "ws/<id>-<slug>",
    "ws/<id>-fix-<slug>",
    "int/<slug>"
  ],
  "families": {
    "S0": {
      "slices": [
        "S0a",
        "S0b"
      ],
      "paths": [
        "Lrm.slnx",
        "global.json",
        "Directory.Build.props",
        "Directory.Build.targets",
        "Directory.Packages.props",
        "build/**",
        ".gitattributes",
        ".gitignore",
        ".editorconfig",
        ".fantomasignore",
        ".config/**",
        ".claude/settings.json",
        ".github/**",
        "tools/bootstrap/**",
        "tools/test.ps1",
        "tests/Lrm.Testing/**",
        "apps/Lrm.Cli/Lrm.Cli.fsproj",
        "apps/Lrm.Cli/Program.fs",
        "docs/STATUS.md",
        "docs/dev-plan.md",
        "docs/ownership.json",
        "docs/project-graph.json",
        "docs/LRM-design.md",
        "README.md",
        "CLAUDE.md",
        "roslyn-research-2026-10-17.zip",
        "tools/ci/**",
        "docs/contracts/README.md",
        "docs/contracts/CHANGELOG.md",
        "docs/decisions/0000-*.md",
        "docs/decisions/0001-*.md",
        "spikes/probes/**",
        "docs/contracts/project-graph.md",
        "docs/contracts/test-tiers.md",
        "docs/contracts/data-root-and-toolchain.md",
        "docs/contracts/agent-permissions.md",
        "docs/contracts/ownership-and-contract-change.md",
        "docs/decisions/S0-*.md"
      ]
    },
    "S1": {
      "slices": [
        "S1"
      ],
      "paths": [
        "src/Lrm.Core/**",
        "tests/Lrm.Core.Tests/**",
        "docs/contracts/lrm-core.md",
        "docs/contracts/telemetry-facade.md",
        "docs/contracts/execution-class.md"
      ]
    },
    "R1": {
      "slices": [
        "R1"
      ],
      "paths": [
        "spikes/vk-heap/**",
        "docs/decisions/R1-*.md"
      ]
    },
    "R2": {
      "slices": [
