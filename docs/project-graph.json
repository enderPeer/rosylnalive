{
  "schema": "lrm.project-graph/1",
  "about": "The only source of ProjectReferences and PackageReferences (ProjectGraph contract). tools/ci/gen-project-graph.ps1 turns it into build/ProjectGraph.g.props (references, imported by Directory.Build.targets), build/ProjectKinds.g.props (output kind, imported by Directory.Build.props) and Lrm.slnx. CI fails when the committed outputs differ from a fresh generation. fsproj files hold file items only. spikes/** is never listed here.",
  "kinds": {
    "lib": "Class library under src/ or tests/.",
    "app": "Console app under apps/. Runs as dotnet <dll>, x64 only, and calls Lrm.Core.Process.init first.",
    "test": "Expecto test exe under tests/, run by tools/test.ps1 with LRM_TEST_TIER set.",
    "tool": "Build-time or codegen exe under src/ or tools/. Referenced only through buildRefs."
  },
  "packages": [
    "Expecto",
    "Expecto.FsCheck",
    "FsCheck"
  ],
  "groups": {
    "backends": [
      "Lrm.Gpu.Vulkan",
      "Lrm.Gpu.D3D12",
      "Lrm.Gpu.CpuDevice"
    ],
    "interop": [
      "Lrm.Gpu.Vulkan.Interop",
      "Lrm.Gpu.D3D12.Interop"
    ],
    "gpu": [
      "Lrm.Gpu.*",
      "Lrm.Shaders",
      "Lrm.Shaders.Build"
    ]
  },
  "rules": [
    {
      "id": "core-is-leaf",
      "from": [ "Lrm.Core" ],
      "forbid": [ "*" ],
      "why": "Core references nothing."
    },
    {
      "id": "model-and-cluster-never-gpu",
      "from": [ "Lrm.Models.Qwen", "Lrm.Cluster" ],
      "forbid": [ "@gpu" ],
      "why": "Models.Qwen and Cluster never reference GPU projects, directly or transitively."
    },
    {
      "id": "exec-never-backend",
      "from": [ "Lrm.Gpu.Exec" ],
      "forbid": [ "@backends", "@interop" ],
      "why": "Gpu.Exec never references a concrete backend or CpuDevice."
    },
    {
      "id": "only-apps-and-tests-wire-backends",
      "fromKinds": [ "lib", "tool" ],
      "forbid": [ "@backends" ],
      "why": "Only apps and tests wire backends."
    },
    {
      "id": "interop-only-under-its-backend",
      "fromKinds": [ "lib", "tool" ],
      "except": [ "Lrm.Gpu.Vulkan", "Lrm.Gpu.D3D12" ],
      "forbid": [ "@interop" ],
      "why": "Interop projects are used by their own backend, apps and tests."
    },
    {
      "id": "build-only-edges",
      "allowBuildRefs": [ "Lrm.Shaders -> Lrm.Shaders.Build" ],
      "why": "Shaders -> Shaders.Build is the only build-only edge (ReferenceOutputAssembly=false)."
    },
    {
      "id": "no-refs-to-executables",
      "forbidRefKinds": [ "app", "test", "tool" ],
      "why": "Nothing references an app, a test exe or a tool except through an allowed build-only edge."
    },
    {
      "id": "acyclic",
      "why": "The graph has no cycles."
    },
    {
      "id": "no-spikes",
      "forbidPaths": [ "spikes/" ],
      "why": "spikes/** is not in the solution and not built in CI."
    }
  ],
  "projects": [
    { "name": "Lrm.Core", "path": "src/Lrm.Core/Lrm.Core.fsproj", "kind": "lib", "owner": "S1", "refs": [] },
    { "name": "Lrm.Telemetry", "path": "src/Lrm.Telemetry/Lrm.Telemetry.fsproj", "kind": "lib", "owner": "T1", "refs": [ "Lrm.Core" ] },
