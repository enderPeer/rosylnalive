# Build output (UseArtifactsOutput puts bin/obj under artifacts/)
artifacts/
bin/
obj/
*.binlog

# IDE and OS clutter
.vs/
.idea/
.ionide/
*.user
*.suo
*.swp
.DS_Store
Thumbs.db
__pycache__/

# Everything under LRM_DATA stays out of git: toolchains, registries, headers,
# model weights, large goldens and run logs. These patterns catch strays.
vk.xml
*.safetensors
*.nupkg
# Small committed goldens are the exception (GoldenSet contract): goldens/tiny/g1/model/model.safetensors and
# the tap files, at most 2 MiB each. Large goldens stay in LRM_DATA/golden; the size check (S0b) bounds goldens/.
!goldens/**/*.safetensors
